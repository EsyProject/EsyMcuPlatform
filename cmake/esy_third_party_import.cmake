if(ENABLE_ESY_LVGL AND NOT TARGET lvgl)
    if(NOT DEFINED LVGL_PATH AND DEFINED ENV{LVGL_PATH})
        set(LVGL_PATH "$ENV{LVGL_PATH}")
    endif()
    if(NOT LVGL_PATH OR NOT EXISTS "${LVGL_PATH}/CMakeLists.txt")
        message(FATAL_ERROR "LVGL support requires LVGL_PATH containing CMakeLists.txt or an existing lvgl target.")
    endif()
    # Source providers use CMake 3.21+ and modern cache semantics.
    function(esy_import_lvgl_provider)
        cmake_policy(PUSH)
        cmake_minimum_required(VERSION 3.21)
        set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
        set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
        add_subdirectory("${LVGL_PATH}" "${CMAKE_BINARY_DIR}/third_party/lvgl")
        cmake_policy(POP)
    endfunction()
    esy_import_lvgl_provider()
    target_compile_options(lvgl PRIVATE ${ESY_PLATFORM_COMPILE_OPTIONS})
    if(esy_port_lvgl_libraries)
        target_link_libraries(lvgl PUBLIC ${esy_port_lvgl_libraries})
    endif()
endif()

if(ENABLE_ESY_LOGGER AND ENABLE_ESY_LOGGER_BACKEND_RTT)
    set(esy_rtt_provider_ready FALSE)
    if(ESY_SEGGER_RTT_TARGET)
        if(TARGET ${ESY_SEGGER_RTT_TARGET})
            set(esy_rtt_provider_ready TRUE)
        elseif(NOT ESY_SEGGER_RTT_TARGET STREQUAL "esy_third_party_segger_rtt")
            message(FATAL_ERROR "ESY_SEGGER_RTT_TARGET must name an existing provider target.")
        endif()
    endif()
    if(NOT esy_rtt_provider_ready AND NOT TARGET SEGGER_RTT)
        if(NOT ESY_SEGGER_RTT_ROOT AND DEFINED ENV{ESY_SEGGER_RTT_ROOT})
            set(ESY_SEGGER_RTT_ROOT "$ENV{ESY_SEGGER_RTT_ROOT}")
        endif()
        if(NOT ESY_SEGGER_RTT_ROOT AND esy_port_segger_rtt_root)
            set(ESY_SEGGER_RTT_ROOT "${esy_port_segger_rtt_root}")
        endif()
        foreach(esy_rtt_file IN ITEMS RTT/SEGGER_RTT.c RTT/SEGGER_RTT.h Config/SEGGER_RTT_Conf.h)
            if(NOT ESY_SEGGER_RTT_ROOT OR NOT EXISTS "${ESY_SEGGER_RTT_ROOT}/${esy_rtt_file}")
                message(FATAL_ERROR
                    "RTT logging requires ESY_SEGGER_RTT_ROOT with RTT sources/configuration or an existing provider target.")
            endif()
        endforeach()
        add_library(esy_third_party_segger_rtt STATIC "${ESY_SEGGER_RTT_ROOT}/RTT/SEGGER_RTT.c")
        target_include_directories(esy_third_party_segger_rtt PUBLIC
            "${ESY_SEGGER_RTT_ROOT}/RTT" "${ESY_SEGGER_RTT_ROOT}/Config")
        target_compile_options(esy_third_party_segger_rtt PRIVATE
            ${ESY_PLATFORM_COMPILE_OPTIONS}
            $<$<C_COMPILER_ID:GNU,Clang>:-Wno-cast-qual>
            $<$<C_COMPILER_ID:GNU,Clang>:-Wno-cast-align>)
        set(ESY_SEGGER_RTT_TARGET esy_third_party_segger_rtt)
    endif()
endif()
