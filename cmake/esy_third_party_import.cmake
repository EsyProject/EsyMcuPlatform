if(DEFINED ESY_TARGET_DEVICE)
    include("${CMAKE_CURRENT_LIST_DIR}/esy_target_device.cmake")
    esy_configure_target_device()
endif()

# These shared checks do not select an SDK or a native kernel port.
macro(esy_select_existing_freertos_provider)
    set(esy_import_kernel TRUE)
    set(esy_freertos_provider_checked TRUE)
    if(FREE_RTOS_KERNEL_LIB)
        if(NOT TARGET ${FREE_RTOS_KERNEL_LIB})
            message(FATAL_ERROR "FREE_RTOS_KERNEL_LIB must name an existing provider target.")
        endif()
        set(esy_import_kernel FALSE)
    elseif(TARGET FreeRTOS-Kernel)
        set(FREE_RTOS_KERNEL_LIB FreeRTOS-Kernel)
        set(esy_import_kernel FALSE)
    elseif(TARGET freertos_kernel)
        set(FREE_RTOS_KERNEL_LIB freertos_kernel)
        set(esy_import_kernel FALSE)
    endif()
endmacro()

macro(esy_require_freertos_sources)
    if(NOT DEFINED FREERTOS_KERNEL_PATH AND DEFINED ENV{FREERTOS_KERNEL_PATH})
        set(FREERTOS_KERNEL_PATH "$ENV{FREERTOS_KERNEL_PATH}")
    endif()
    if(NOT FREERTOS_KERNEL_PATH OR NOT EXISTS "${FREERTOS_KERNEL_PATH}/include/FreeRTOS.h")
        message(FATAL_ERROR "FreeRTOS import requires an explicit FREERTOS_KERNEL_PATH checkout.")
    endif()
    if(NOT ESY_RTOS_CONFIG_DIR OR NOT EXISTS "${ESY_RTOS_CONFIG_DIR}/FreeRTOSConfig.h")
        message(FATAL_ERROR "FreeRTOS import requires ESY_RTOS_CONFIG_DIR containing FreeRTOSConfig.h.")
    endif()
endmacro()

set(esy_port_lvgl_libraries "")
set(esy_port_segger_rtt_root "")
set(esy_freertos_provider_checked FALSE)
if(ESY_BUILD_PORT)
    esy_call_port_hook(initialize_sdk_dependencies)
endif()
if(ESY_RTOS STREQUAL "FreeRTOS" AND NOT esy_freertos_provider_checked)
    esy_select_existing_freertos_provider()
    if(esy_import_kernel)
        message(FATAL_ERROR "No FreeRTOS provider importer for ESY_TARGET_PLATFORM=${ESY_TARGET_PLATFORM}.")
    endif()
endif()

# Defer target creation until library assembly so consumers can supply providers
# on either side of project import. This directory-scoped opt-in is inherited
# only by consumers using the optional integration helper.
set(esy_network_provider_defaults_enabled TRUE)
function(esy_configure_default_network_providers)
    if(ESY_BUILD_PORT)
        esy_call_port_hook(configure_network_providers)
    endif()
endfunction()

