# Supplement the SDK's own package lookup only while this port owns SDK init.
# User package hints and existing system prefixes keep their normal precedence;
# the SDK retains version validation, imported targets and source-build fallback.
function(esy_port_pico_append_host_tool_prefixes)
    if(NOT PICO_SDK_VERSION_STRING OR NOT PICO_SDK_PATH)
        return()
    endif()
    get_filename_component(sdk_root "${PICO_SDK_PATH}" REALPATH
        BASE_DIR "${CMAKE_SOURCE_DIR}")
    get_filename_component(installer_root "${sdk_root}/../.." ABSOLUTE)
    set(force_picotool_fetch "$ENV{PICOTOOL_FORCE_FETCH_FROM_GIT}")
    foreach(host_tool IN ITEMS pioasm picotool)
        if(TARGET ${host_tool})
            continue()
        endif()
        if(host_tool STREQUAL "pioasm")
            set(package_prefix "${installer_root}/tools/${PICO_SDK_VERSION_STRING}/pioasm")
        else()
            if(PICOTOOL_FORCE_FETCH_FROM_GIT OR force_picotool_fetch)
                continue()
            endif()
            set(package_prefix "${installer_root}/picotool/${PICO_SDK_VERSION_STRING}/picotool")
        endif()
        if(EXISTS "${package_prefix}/${host_tool}Config.cmake" AND
           NOT package_prefix IN_LIST CMAKE_SYSTEM_PREFIX_PATH)
            list(APPEND CMAKE_SYSTEM_PREFIX_PATH "${package_prefix}")
        endif()
    endforeach()
    set(CMAKE_SYSTEM_PREFIX_PATH "${CMAKE_SYSTEM_PREFIX_PATH}" PARENT_SCOPE)
endfunction()

macro(esy_port_pico_initialize_sdk_dependencies)
    if(ESY_RTOS STREQUAL "FreeRTOS" AND
       (NOT DEFINED TINYUSB_OPT_OS OR TINYUSB_OPT_OS STREQUAL ""))
        set(TINYUSB_OPT_OS OPT_OS_PICO)
    endif()
    if(NOT TARGET pico_stdlib)
        if(NOT COMMAND pico_sdk_init)
            message(FATAL_ERROR "Pico SDK must be imported before project().")
        endif()
        esy_port_pico_append_host_tool_prefixes()
        pico_sdk_init()
    endif()

    if(ESY_RTOS STREQUAL "FreeRTOS")
        esy_select_existing_freertos_provider()
        if(esy_import_kernel)
            esy_require_freertos_sources()
            if(PICO_PLATFORM STREQUAL "rp2040")
                set(esy_freertos_port RP2040)
            else()
                set(esy_freertos_port RP2350_ARM_NTZ)
            endif()
            set(esy_freertos_port_dir
                "${FREERTOS_KERNEL_PATH}/portable/ThirdParty/GCC/${esy_freertos_port}")
            if(NOT EXISTS "${esy_freertos_port_dir}/CMakeLists.txt")
                message(FATAL_ERROR "FREERTOS_KERNEL_PATH must provide portable/ThirdParty/GCC/${esy_freertos_port}.")
            endif()
            set(FREERTOS_CONFIG_FILE_DIRECTORY "${ESY_RTOS_CONFIG_DIR}")
            add_subdirectory("${esy_freertos_port_dir}" "${CMAKE_BINARY_DIR}/third_party/freertos")
            set(FREE_RTOS_KERNEL_LIB FreeRTOS-Kernel)
        endif()
        if(TARGET tinyusb_common)
            target_link_libraries(tinyusb_common INTERFACE ${FREE_RTOS_KERNEL_LIB})
        endif()
    endif()

    # Generic software assembly consumes these SDK-owned integration dependencies.
    set(esy_port_lvgl_libraries pico_stdlib)
    set(esy_port_segger_rtt_root "${PICO_SDK_PATH}/src/rp2_common/pico_stdio_rtt/SEGGER")
endmacro()

function(esy_port_pico_configure_network_providers)
    if(NOT ESY_TARGET_PLATFORM STREQUAL "PICO_W" AND NOT ESY_TARGET_PLATFORM STREQUAL "PICO2_W")
        return()
    endif()
    set(esy_network_provider_targets "")
    if(ENABLE_ESY_WIFI AND NOT TARGET esy_wifi_provider)
        list(APPEND esy_network_provider_targets esy_wifi_provider)
    endif()
    if(ENABLE_ESY_NETWORK AND ENABLE_ESY_NETWORK_LWIP
            AND NOT TARGET esy_network_lwip_provider)
        list(APPEND esy_network_provider_targets esy_network_lwip_provider)
    endif()
    if(esy_network_provider_targets)
        if(NOT TARGET esy_project_options)
            message(FATAL_ERROR
                "Default Pico network providers require esy_project_options. Include esy_project_import.cmake after project() or supply the network provider targets explicitly.")
        endif()
        if(NOT TARGET pico_cyw43_arch_lwip_poll)
            message(FATAL_ERROR
                "Default Pico network providers (${esy_network_provider_targets}) require the Pico SDK pico_cyw43_arch_lwip_poll target. Initialize the SDK with CYW43/lwIP support or supply the provider targets explicitly.")
        endif()
        foreach(esy_network_provider IN LISTS esy_network_provider_targets)
            add_library(${esy_network_provider} INTERFACE)
            target_link_libraries(${esy_network_provider} INTERFACE
                pico_cyw43_arch_lwip_poll esy_project_options)
            if(ESY_RTOS STREQUAL "FreeRTOS")
                target_link_libraries(${esy_network_provider} INTERFACE ${FREE_RTOS_KERNEL_LIB})
            endif()
        endforeach()
    endif()
endfunction()

macro(esy_port_pico_export_sdk_variables)
    if(COMMAND pico_promote_common_scope_vars)
        pico_promote_common_scope_vars()
    endif()
    foreach(esy_pico_output IN ITEMS PICO_SDK CMAKE_EXECUTABLE_SUFFIX)
        if(DEFINED ${esy_pico_output})
            set(${esy_pico_output} "${${esy_pico_output}}" PARENT_SCOPE)
        endif()
    endforeach()
endmacro()

macro(esy_port_pico_select_atomic_backend)
    if((ESY_TARGET_PLATFORM STREQUAL "PICO" OR ESY_TARGET_PLATFORM STREQUAL "PICO_W") AND
       TARGET pico_atomic)
        set(ESY_ATOMIC_IRQ_SPINLOCK_BACKEND ON)
        message(STATUS "EsyMcuPlatform atomics: Pico SDK IRQ-masked hardware spinlock backend")
    endif()
endmacro()

function(esy_port_pico_configure_coredump_target target)
    if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PRIVATE -mgeneral-regs-only)
    endif()
endfunction()

function(esy_port_pico_configure_firmware target)
    get_target_property(esy_firmware_type ${target} TYPE)
    if(NOT esy_firmware_type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "ESY_FIRMWARE_TARGET must be an executable for ESY_TARGET_PLATFORM=${ESY_TARGET_PLATFORM}.")
    endif()
    set(esy_firmware_slot DEFAULT)
    if(DEFINED ESY_APP_SLOT)
        string(TOUPPER "${ESY_APP_SLOT}" esy_firmware_slot)
        if(NOT esy_firmware_slot MATCHES "^(A|B)$")
            message(FATAL_ERROR "ESY_APP_SLOT must be A or B, or unset for the default image.")
        endif()
    endif()
    set(ESY_LINK_SCRIPT "${ESY_LINKER_SCRIPT_${esy_firmware_slot}}")
    if(NOT IS_ABSOLUTE "${ESY_LINK_SCRIPT}" OR NOT EXISTS "${ESY_LINK_SCRIPT}" OR IS_DIRECTORY "${ESY_LINK_SCRIPT}")
        message(FATAL_ERROR "ESY_LINKER_SCRIPT_${esy_firmware_slot} must name an existing absolute linker script.")
    endif()
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${ESY_LINK_SCRIPT}")
    set_target_properties(${target} PROPERTIES
        SUFFIX ".elf"
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")

    foreach(esy_pico_command IN ITEMS pico_enable_stdio_uart pico_enable_stdio_rtt
            pico_enable_stdio_usb pico_add_extra_outputs pico_set_linker_script)
        if(NOT COMMAND ${esy_pico_command})
            message(FATAL_ERROR "Firmware integration requires Pico SDK command ${esy_pico_command}.")
        endif()
    endforeach()
    if(ENABLE_ESY_STDIO_UART)
        pico_enable_stdio_uart(${target} 1)
    else()
        pico_enable_stdio_uart(${target} 0)
    endif()
    if(ENABLE_ESY_STDIO_RTT)
        pico_enable_stdio_rtt(${target} 1)
    else()
        pico_enable_stdio_rtt(${target} 0)
    endif()
    pico_enable_stdio_usb(${target} 0)
    pico_add_extra_outputs(${target})
    target_link_libraries(${target} PRIVATE pico_stdlib)
    target_link_options(${target} PRIVATE -Wl,--print-memory-usage)
    pico_set_linker_script(${target} "${ESY_LINK_SCRIPT}")
endfunction()
