include_guard(GLOBAL)

# Discover pure port descriptors without importing SDKs or project metadata.
function(esy_resolve_target_device device)
    string(TOUPPER "${device}" esy_device)
    if(esy_device STREQUAL "")
        message(FATAL_ERROR "ESY_TARGET_DEVICE must be explicitly provided.")
    endif()

    set(esy_required_fields ESY_TARGET_DEVICE ESY_TARGET_PLATFORM ESY_BUILD_PORT
        ESY_BOARD_PLATFORM_PATH ESY_SPECS_PLATFORM_PATH)
    set(esy_export_fields ${esy_required_fields})
    set(esy_matching_ports "")
    # Adding a port requires a fresh configure; script mode uses the same scan.
    file(GLOB esy_descriptors LIST_DIRECTORIES FALSE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ports/*/device_map.cmake")
    list(SORT esy_descriptors)
    foreach(esy_descriptor IN LISTS esy_descriptors)
        get_filename_component(esy_port_directory "${esy_descriptor}" DIRECTORY)
        get_filename_component(esy_port_name "${esy_port_directory}" NAME)
        if(NOT esy_port_name MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid port descriptor directory: ${esy_port_directory}")
        endif()
        set(ESY_PORT_EXPORT_FIELDS "__ESY_UNDECLARED__")
        include("${esy_descriptor}")
        if(ESY_PORT_EXPORT_FIELDS STREQUAL "__ESY_UNDECLARED__" OR
           NOT COMMAND esy_port_${esy_port_name}_match OR
           NOT COMMAND esy_port_${esy_port_name}_resolve)
            message(FATAL_ERROR
                "Port ${esy_port_name} must declare ESY_PORT_EXPORT_FIELDS and namespaced match/resolve functions")
        endif()
        string(TOUPPER "${esy_port_name}" esy_port_namespace)
        foreach(esy_field IN LISTS ESY_PORT_EXPORT_FIELDS)
            list(FIND esy_required_fields "${esy_field}" esy_required_field_index)
            if(NOT esy_field MATCHES "^ESY_${esy_port_namespace}_[A-Z0-9_]+$" OR
               esy_required_field_index GREATER_EQUAL 0 OR
               esy_field STREQUAL "ESY_TARGET_EXPORT_FIELDS")
                message(FATAL_ERROR "Port ${esy_port_name} declares an invalid extra output: ${esy_field}")
            endif()
        endforeach()
        set(esy_port_${esy_port_name}_fields "${ESY_PORT_EXPORT_FIELDS}")
        list(APPEND esy_export_fields ${ESY_PORT_EXPORT_FIELDS})
        set(esy_port_matched "__ESY_UNDECLARED__")
        cmake_language(CALL esy_port_${esy_port_name}_match "${esy_device}" esy_port_matched)
        if(NOT esy_port_matched MATCHES "^(TRUE|FALSE|ON|OFF|1|0)$")
            message(FATAL_ERROR "Port ${esy_port_name} match must return a boolean")
        endif()
        if(esy_port_matched)
            list(APPEND esy_matching_ports "${esy_port_name}")
        endif()
    endforeach()
    list(LENGTH esy_matching_ports esy_match_count)
    if(esy_match_count EQUAL 0)
        message(FATAL_ERROR "Unsupported ESY_TARGET_DEVICE: ${device}")
    elseif(NOT esy_match_count EQUAL 1)
        message(FATAL_ERROR
            "Ambiguous ESY_TARGET_DEVICE=${esy_device}: matched ports ${esy_matching_ports}")
    endif()

    list(GET esy_matching_ports 0 esy_selected_port)
    set(esy_selected_fields ${esy_required_fields} ${esy_port_${esy_selected_port}_fields})
    foreach(esy_field IN LISTS esy_selected_fields)
        # Shadow inherited values so omitted descriptor outputs cannot look valid.
        set(esy_result_${esy_field} "__ESY_MISSING_OUTPUT__")
    endforeach()
    cmake_language(CALL esy_port_${esy_selected_port}_resolve "${esy_device}" esy_result)
    foreach(esy_field IN LISTS esy_selected_fields)
        if(esy_result_${esy_field} STREQUAL "__ESY_MISSING_OUTPUT__")
            message(FATAL_ERROR "Port ${esy_selected_port} omitted required output ${esy_field}")
        endif()
        if("${esy_result_${esy_field}}" MATCHES "[\r\n;]")
            message(FATAL_ERROR "Port ${esy_selected_port} output ${esy_field} must be a scalar")
        endif()
    endforeach()
    if(NOT esy_result_ESY_TARGET_DEVICE STREQUAL esy_device)
        message(FATAL_ERROR "Port ${esy_selected_port} changed normalized ESY_TARGET_DEVICE")
    endif()
    if(NOT esy_result_ESY_TARGET_PLATFORM MATCHES "^[A-Z][A-Z0-9_]*$")
        message(FATAL_ERROR "Port ${esy_selected_port} returned invalid ESY_TARGET_PLATFORM")
    endif()
    if(NOT esy_result_ESY_BUILD_PORT STREQUAL esy_selected_port)
        message(FATAL_ERROR "Port ${esy_selected_port} must return its own ESY_BUILD_PORT")
    endif()
    foreach(esy_field IN ITEMS ESY_BOARD_PLATFORM_PATH ESY_SPECS_PLATFORM_PATH)
        if(NOT esy_result_${esy_field} MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Port ${esy_selected_port} returned invalid ${esy_field}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES esy_export_fields)
    foreach(esy_field IN LISTS esy_export_fields)
        list(FIND esy_selected_fields "${esy_field}" esy_selected_field_index)
        if(esy_selected_field_index GREATER_EQUAL 0)
            set(${esy_field} "${esy_result_${esy_field}}" PARENT_SCOPE)
        else()
            set(${esy_field} "" PARENT_SCOPE)
        endif()
    endforeach()
    set(ESY_TARGET_EXPORT_FIELDS "${esy_export_fields}" PARENT_SCOPE)
endfunction()

# DEVICE is the sole configurable input. Recompute every derived field on each
# entry, clearing derived cache values rather than trusting stale state.
macro(esy_configure_target_device)
    esy_resolve_target_device("${ESY_TARGET_DEVICE}")
    set(ESY_TARGET_DEVICE "${ESY_TARGET_DEVICE}" CACHE STRING "Consumer-selected build target" FORCE)
    # Compare field names without policy-dependent if() variable dereferencing.
    set(esy_derived_fields ${ESY_TARGET_EXPORT_FIELDS})
    list(REMOVE_ITEM esy_derived_fields ESY_TARGET_DEVICE)
    foreach(esy_derived_field IN LISTS esy_derived_fields)
        unset(${esy_derived_field} CACHE)
    endforeach()
    unset(esy_derived_fields)
    unset(ESY_TARGET_EXPORT_FIELDS CACHE)
endmacro()

# Shell tooling uses the same resolver and receives a machine-readable file.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    esy_resolve_target_device("${ESY_TARGET_DEVICE}")
    if(NOT ESY_TARGET_MAP_FILE)
        message(FATAL_ERROR "Set ESY_TARGET_MAP_FILE for the resolved target mapping.")
    endif()
    file(WRITE "${ESY_TARGET_MAP_FILE}" "")
    foreach(esy_field IN LISTS ESY_TARGET_EXPORT_FIELDS)
        file(APPEND "${ESY_TARGET_MAP_FILE}" "${esy_field}=${${esy_field}}\n")
    endforeach()
endif()
